# Environment configuration for k8s-ai-troubleshooter Docker Compose
# Copy this file to .env and adjust variables as needed.

# Path to your read-only kubeconfig (defaults to ~/.kube/config)
KUBECONFIG=~/.kube/config

# Target Kubernetes namespace for diagnosis (defaults to "default")
K8S_NAMESPACE=default

# Tool versions for building the k8s-ai image locally
KUBECTL_VERSION=v1.37.0
HELM_VERSION=v4.2.4
