{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionTreeSchema",
  "type": "object",
  "required": ["id", "title", "trigger", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "required": ["symptom"],
      "properties": {
        "symptom": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "command"],
        "properties": {
          "id": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["read", "inspect", "evaluate", "confirm", "remediate_approval_required"]
          },
          "command": { "type": "string" },
          "purpose": { "type": "string" },
          "next": { "type": "string" },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["condition", "next"],
              "properties": {
                "condition": { "type": "string" },
                "next": { "type": "string" },
                "hypothesis": { "type": "string" },
                "confidence": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
