{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandCatalogSchema",
  "type": "object",
  "required": ["version", "catalog", "commands"],
  "properties": {
    "version": { "type": "string" },
    "catalog": { "type": "string" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "category",
          "purpose",
          "safety",
          "namespace_scope",
          "cluster_scope",
          "official_docs"
        ],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "category": { "type": "string" },
          "purpose": { "type": "string" },
          "safety": {
            "type": "string",
            "enum": ["SAFE_READ", "SAFE_DIAGNOSTIC", "HUMAN_APPROVAL_REQUIRED", "DESTRUCTIVE"]
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "namespace_scope": { "type": "boolean" },
          "cluster_scope": { "type": "boolean" },
          "expected_output": { "type": "string" },
          "failure_modes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "official_docs": { "type": "string" }
        }
      }
    }
  }
}
