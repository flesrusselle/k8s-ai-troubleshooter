{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunbookSchema",
  "type": "object",
  "required": [
    "id",
    "title",
    "purpose",
    "safety_level",
    "symptoms",
    "diagnostic_commands",
    "root_cause_patterns",
    "remediation",
    "human_approval_required",
    "official_docs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "when_to_use": {
      "type": "string"
    },
    "safety_level": {
      "type": "string",
      "enum": ["SAFE_READ", "SAFE_DIAGNOSTIC", "HUMAN_APPROVAL_REQUIRED", "DESTRUCTIVE"]
    },
    "symptoms": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "quick_diagnosis": {
      "type": "string"
    },
    "detailed_investigation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostic_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "decision_tree": {
      "type": "string"
    },
    "evidence_to_collect": {
      "type": "array",
      "items": { "type": "string" }
    },
    "root_cause_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "likely_cause", "confidence"],
        "properties": {
          "pattern": { "type": "string" },
          "likely_cause": { "type": "string" },
          "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] }
        }
      },
      "minItems": 1
    },
    "confirmation": {
      "type": "string",
      "description": "How to confirm the ROOT CAUSE before acting. Distinct from verification, which checks the fix afterwards."
    },
    "remediation": {
      "type": "string"
    },
    "blast_radius": {
      "type": "string",
      "description": "What the remediation affects, and for how long. Stated before approval is requested, so the operator is deciding with the cost in view."
    },
    "verification": {
      "type": "string",
      "description": "Observable evidence that the fix worked. A remediation with no verification step is a hope, not a fix."
    },
    "rollback": {
      "type": "string",
      "description": "How to undo the remediation, and what it cannot undo. Some fixes have irreversible side effects; saying so is part of the answer."
    },
    "human_approval_required": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "related_runbooks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "official_docs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
