{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "k8s-ai-troubleshooter values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag":        { "type": "string", "minLength": 1 },
        "digest":     { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create":      { "type": "boolean" },
        "annotations": { "type": "object" },
        "name":        { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create":          { "type": "boolean" },
        "allowSecretRead": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "cronJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schedule"],
      "properties": {
        "enabled":                    { "type": "boolean" },
        "schedule":                   { "type": "string", "minLength": 1 },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Allow", "Forbid", "Replace"]
        },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit":     { "type": "integer", "minimum": 0 },
        "backoffLimit":               { "type": "integer", "minimum": 0 },
        "restartPolicy": {
          "type": "string",
          "enum": ["Never", "OnFailure"]
        },
        "activeDeadlineSeconds":      { "type": "integer", "minimum": 30 },
        "ttlSecondsAfterFinished":    { "type": "integer", "minimum": 0 }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allNamespaces":   { "type": "boolean" },
        "namespace":       { "type": "string" },
        "includePods":     { "type": "boolean" },
        "includeOptional": { "type": "boolean" },
        "timeoutSeconds":  { "type": "integer", "minimum": 10, "maximum": 600 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":          { "type": "boolean" },
        "existingClaim":    { "type": "string" },
        "size":             { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E)?$" },
        "storageClassName": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"]
        }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext":    { "type": "object" },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits":   { "type": "object" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations":  { "type": "array" },
    "affinity":     { "type": "object" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":      { "type": "boolean" },
        "image":        { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":     { "type": "boolean" },
            "className":   { "type": "string" },
            "host":        { "type": "string" },
            "annotations": { "type": "object" },
            "tls":         { "type": "array" }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": { "type": "object" },
            "limits":   { "type": "object" }
          }
        }
      }
    }
  }
}
